            VALUE "LegalCopyright",   "Open Source"
            VALUE "OriginalFilename", "stuttometer_gui.exe"
            VALUE "ProductName",      "Stuttometer"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
