#include <windows.h>
#include "resource.h"
#include "stuttometer/version.hpp"

IDI_APP_ICON ICON "app_icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     STUTTOMETER_VERSION_QUAD
PRODUCTVERSION  STUTTOMETER_VERSION_QUAD
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Stuttometer Project"
            VALUE "FileDescription",  "Stuttometer Real-Time ETW Diagnostic Utility GUI"
            VALUE "FileVersion",      STUTTOMETER_VERSION_QUAD_STRING
            VALUE "InternalName",     "stuttometer_gui"
            VALUE "LegalCopyright",   "Open Source"
            VALUE "OriginalFilename", "stuttometer_gui.exe"
            VALUE "ProductName",      "Stuttometer"
            VALUE "ProductVersion",   STUTTOMETER_VERSION_QUAD_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
